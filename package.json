{
  "name": "personal-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "publish": "node scripts/publish.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "admin": "node admin/server.mjs",
    "admin:test": "node --test admin/*.test.mjs",
    "test": "node --test admin/*.test.mjs scripts/*.test.mjs",
    "check": "astro check",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "astro": "7.4.1",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "three": "0.183.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/three": "0.183.0",
    "es-module-lexer": "3.0.4",
    "typescript": "~5.9.3"
  }
}
