---
interface Props { archive?: boolean }
const { archive = false } = Astro.props;
---
<button class="icon-button music-toggle" type="button" popovertarget="music-player" aria-label="音乐播放器" title="音乐播放器">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 17V6l11-2v11M9 9l11-2"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="17" cy="16" rx="3" ry="2"/></svg>
  <span data-resume-hint hidden>继续播放</span>
</button>
<button type="button" id={archive ? undefined : 'theme-toggle'} class:list={['icon-button','theme-toggle',{'archive-theme-toggle':archive}]} data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.6 13.4A8.5 8.5 0 0 1 10.6 3a8.5 8.5 0 0 0 10 10.4Z"/></svg>
</button>
