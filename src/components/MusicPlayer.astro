---
import { musicAlbums } from '../data/library';
import '../styles/music-player.css';
---
<section id="music-player" popover aria-label="音乐播放器" lang="zh-CN">
  <div class="audio-summary">
    <div class="audio-record" aria-hidden="true"><img data-audio-cover alt="" width="62" height="62" loading="lazy" hidden /></div>
    <div class="audio-info">
      <h2 data-audio-title>暂无曲目</h2>
      <a data-audio-album href="/library/" title="浏览作品志专辑">浏览作品志专辑</a>
      <div class="audio-levels">
        <span data-audio-time>0:00 / 0:00</span>
        <button type="button" data-audio-mute aria-label="静音" title="静音" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 9h4l5-4v14l-5-4H3z"/><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path class="audio-sound" d="M15.5 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/><path class="audio-silent" d="m16 9 5 6m0-6-5 6"/></g></svg>
        </button>
        <input class="audio-range" type="range" min="0" max="100" value="100" data-audio-volume aria-label="音量" />
      </div>
    </div>
  </div>
  <input class="audio-range" type="range" min="0" max="0" step="0.1" value="0" data-audio-seek aria-label="播放进度" disabled />
  <div class="audio-actions">
    <button type="button" data-audio-prev aria-label="上一首" title="上一首" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h3v14H4zm15.4.3a1 1 0 0 1 1.6.8v11.8a1 1 0 0 1-1.6.8L10 12.8a1 1 0 0 1 0-1.6z"/></svg></button>
    <button type="button" data-audio-toggle aria-label="播放" title="播放" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path class="audio-play" d="M6 4.6a1.6 1.6 0 0 1 2.4-1.4l12 7.4a1.6 1.6 0 0 1 0 2.8l-12 7.4A1.6 1.6 0 0 1 6 19.4z"/><path class="audio-pause" d="M5 4h5v16H5zm9 0h5v16h-5z"/></svg></button>
    <button type="button" data-audio-next aria-label="下一首" title="下一首" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 5h-3v14h3zM4.6 5.3A1 1 0 0 0 3 6.1v11.8a1 1 0 0 0 1.6.8l9.4-5.9a1 1 0 0 0 0-1.6z"/></svg></button>
    <button type="button" data-audio-list aria-label="专辑曲目" title="专辑曲目" aria-controls="audio-queue" aria-expanded="false" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h17v2H3zm0 5h11v2H3zm0 5h7v2H3zm16-6h2v8.5a3.5 3.5 0 1 1-2-3.2z"/></svg></button>
  </div>
  <p data-audio-status role="status"></p>
  <section id="audio-queue" aria-label="专辑曲目" hidden><header><strong data-queue-title></strong><span data-audio-count></span></header><ol></ol></section>
</section>
<script id="music-catalog" type="application/json" set:html={JSON.stringify(musicAlbums).replace(/</g, '\\u003c')}></script>
<script>import '../scripts/music-player';</script>
