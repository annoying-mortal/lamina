---
import { archiveRecordPresentation, createArchiveCollection, type ArchivePost, type ArchiveCategory, type ArchiveFriend } from '../archive/data';
import { imageSource, type SiteSettings } from '../data/site';
import type { LibraryItem } from '../data/library';
import '../styles/archive.css';
import ArchiveSearch from './ArchiveSearch.astro';
import AlbumTrackList from './AlbumTrackList.astro';
import SiteControls from './SiteControls.astro';
interface Props {
  posts: ArchivePost[];
  categories: readonly ArchiveCategory[];
  library?: LibraryItem[];
  friends?: readonly ArchiveFriend[];
  site: Pick<SiteSettings, 'name' | 'title' | 'archiveTitle' | 'archiveSubtitle' | 'logo' | 'libraryTypes'>;
}
const { posts, categories, site, library = [], friends = [] } = Astro.props;
const logo = imageSource(site.logo);
const collection = createArchiveCollection(
  posts,
  categories,
  library.map(item => ({ ...item, cover: imageSource(item.cover) })),
  site.libraryTypes,
  friends,
);
const { posts: records, categories: populatedCategories } = collection;
const first = records[0];
const firstPresentation = first && archiveRecordPresentation(first);
const firstCode = `${firstPresentation?.prefix ?? 'B'}-${records.length ? '001' : '000'}`;
const firstIsLibrary = first?.kind === 'library';
const firstIsFriend = first?.kind === 'friend';
const firstCategoryIndex = populatedCategories.findIndex(category => category.id === first?.categoryId);
const firstCategory = populatedCategories[firstCategoryIndex]?.label;
const serialized = JSON.stringify({ ...collection, branding: { title: site.archiveTitle, subtitle: site.archiveSubtitle } }).replace(/</g, '\\u003c');
---
<section id="archives" class="archive-section" data-mode="archive" data-kind={first?.kind} data-empty={String(!records.length)} aria-label="Blog, Library and Friends archive">
  <div id="archive-canvas" data-archive-title={site.archiveTitle} aria-label="3D archive. Use arrow keys to select."></div>

  <header class="archive-brand" aria-label={site.title}>
    <a href="#welcome" data-logo-slot aria-label={`${site.name} home`}>{logo && <img class="archive-logo" data-fallback-image src={logo} alt="" />}<strong data-logo-fallback hidden={Boolean(logo)}>{site.name}</strong><span>{site.archiveSubtitle}</span><b>{site.archiveTitle} <i>01</i></b></a>
  </header>
  <nav class="archive-system-nav" aria-label="Archive navigation">
    <ArchiveSearch siteName={site.name} categories={populatedCategories.filter(category => category.id !== 'friends')} />
    <a href="/blog/" class="archive-index-link"><span>Blog</span></a>
    <a href="/library/" class="archive-index-link archive-library-link"><span>Library</span></a>
    <a href="/friends/" class="archive-index-link"><span>Friends</span></a>
    <SiteControls archive />
  </nav>

  <div id="archive-selection" class="archive-selection">
    <div class="archive-callout">
      <div class="archive-kicker">{site.archiveTitle} <span>/</span> <span id="archive-category">{firstCategory}</span></div>
      <button type="button" id="archive-open" class="archive-file-button" aria-label={first ? `Preview: ${first.title}` : 'Preview selected entry'}>FILE NUMBER: <span id="archive-file-code">{firstCode}</span><i aria-hidden="true">↗</i></button>
      <div class="archive-callout-rule" aria-hidden="true"><i></i></div>
      <h2 id="archive-title">{first?.title}</h2>
      <div class="archive-callout-meta"><span id="archive-date">{firstPresentation?.selectionMeta}</span><span id="archive-kind">{firstPresentation?.kind}</span></div>
      <button type="button" id="archive-extract" class="archive-extract"><span id="archive-extract-label">Preview</span> <span aria-hidden="true">→</span></button>
    </div>

    <div class="archive-counter"><span>ARCHIVE / SELECT</span><div><strong id="archive-number">{records.length ? '01' : '00'}</strong><i>/</i><span id="archive-total">{String(records.filter(record => record.categoryId === first?.categoryId).length).padStart(2, '0')}</span></div></div>
    <div class="archive-row-navigation" aria-label="Select entry"><button id="archive-prev" type="button" aria-label="Previous entry">↑</button><div id="archive-ticks" class="archive-ticks" aria-hidden="true"></div><button id="archive-next" type="button" aria-label="Next entry">↓</button><span id="archive-count" class="archive-sr-only"></span></div>
    <div class="archive-column-navigation" aria-label="Category"><button id="category-prev" type="button" aria-label="Previous category">←</button><div><span>COLUMN <span id="archive-category-count">{String(firstCategoryIndex + 1).padStart(2, '0')} / {String(populatedCategories.length).padStart(2, '0')}</span></span><strong id="archive-category-name">{firstCategory}</strong></div><button id="category-next" type="button" aria-label="Next category">→</button></div>
    <div id="archive-categories" class="archive-categories" aria-label="Blog categories, Library types and Friends"></div>
    <p class="archive-keyboard-hint"><kbd>←</kbd> <kbd>→</kbd> Category <i>/</i> <kbd>↑</kbd> <kbd>↓</kbd> Entry <i>/</i> <kbd>ENTER</kbd> Preview</p>
  </div>

  <div id="archive-preview" class="archive-preview" aria-hidden="true" inert>
    <button id="archive-back" class="archive-back" type="button">← <span>Archive</span><small>ESC</small></button>
    <div class="archive-object-caption" aria-hidden="true"><span id="archive-object-code">NO.001</span><small>{site.archiveTitle}</small></div>
    <article id="archive-preview-content" class="archive-preview-content" aria-labelledby="archive-preview-title" tabindex="-1">
      <div class="archive-preview-body" tabindex="-1">
        <div class="archive-preview-kicker"><span id="archive-preview-code">FILE {firstCode}</span><span id="archive-preview-kind">{firstPresentation?.previewKind}</span></div>
        <div class="archive-preview-heading">
          <div><h2 id="archive-preview-title">{first?.title}</h2><p id="archive-preview-original" class="archive-preview-original" hidden={!firstIsLibrary || !first?.original || first.original === first.title}>{first?.original}</p><p class="archive-preview-subtitle"><span id="archive-preview-category">{firstCategory}</span><span id="archive-preview-label">{firstPresentation?.previewLabel}</span></p></div>
          <img id="archive-preview-cover" class="archive-preview-cover" src={first?.cover || undefined} alt={first ? `${first.title}${firstIsFriend ? ' avatar' : first.demo ? ' demo cover' : ' cover'}` : ''} width="84" height={firstIsFriend ? '84' : '112'} decoding="async" hidden={!first?.cover} />
        </div>
        <div class="archive-preview-rule"></div>
        <dl class="archive-metadata">
          <div><dt id="archive-preview-category-label">{firstPresentation?.categoryLabel}</dt><dd id="archive-preview-category-value">{firstPresentation?.categoryValue}</dd></div>
          <div id="archive-preview-date-row" hidden={firstIsFriend}><dt id="archive-preview-date-label">{firstPresentation?.dateLabel}</dt><dd id="archive-preview-date">{first?.date || '—'}</dd></div>
          <div><dt>TAGS</dt><dd id="archive-preview-tags">{first?.tags.join(' · ') || '—'}</dd></div>
          <div id="archive-preview-reading-row" hidden={firstIsFriend}><dt id="archive-preview-reading-label">{firstPresentation?.readingLabel}</dt><dd id="archive-preview-readtime">{firstPresentation?.readingValue}</dd></div>
          <div id="archive-preview-rating-row" hidden={!firstIsLibrary}><dt>RATING</dt><dd id="archive-preview-rating">{first?.rating ? `${first.rating} / 10${first.demo ? ' · Demo rating' : ''}` : 'Unrated'}</dd></div>
        </dl>
        <div class="archive-abstract"><span id="archive-summary-label">{firstPresentation?.summaryLabel}</span><p id="archive-summary">{first?.summary}</p></div>
        <section id="archive-preview-tracks" aria-label="Album tracks" hidden>
          <h3>Tracks</h3>
          {library.filter(item => item.tracks?.length).map(album => <AlbumTrackList album={album} hidden />)}
        </section>
      </div>
      <a id="archive-read" class="archive-read-button" href={first?.href ?? '/blog/'} target={firstIsFriend ? '_blank' : undefined} rel={firstIsFriend ? 'noopener noreferrer' : undefined} aria-label={first ? `${firstPresentation!.readAction}: ${first.title}` : undefined}><span id="archive-read-label">{firstPresentation?.readLabel}</span><i aria-hidden="true">↗</i></a>
      <div class="archive-preview-footnote"><span id="archive-preview-count">{records.length ? '001' : '000'} / {String(records.length).padStart(3, '0')}</span></div>
    </article>
  </div>

  <div class="archive-empty"><span>BLOG / LIBRARY / FRIENDS</span><h2>Enter blog, library or friend content</h2><a href="/blog/">Blog →</a><a href="/library/">Library →</a><a href="/friends/">Friends →</a></div>
  <div class="archive-footer"><span id="archive-status" role="status" aria-live="polite">{records.length ? 'Loading archive' : 'No entries'}</span><span>{String(posts.length).padStart(2, '0')} BLOG <i>/</i> {String(library.length).padStart(2, '0')} LIBRARY <i>/</i> {String(friends.length).padStart(2, '0')} FRIENDS <i>/</i> {String(records.length).padStart(3, '0')} RECORDS</span></div>
  <noscript><div class="archive-noscript"><p>Enable JavaScript for the 3D archive.</p><a href="/blog/">Blog →</a><a href="/library/">Library →</a><a href="/friends/">Friends →</a></div></noscript>
  <script id="archive-data" type="application/json" set:html={serialized}></script>
</section>
<script>import '../scripts/archive';</script>
