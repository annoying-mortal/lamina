---
import { createArchiveCollection, type ArchivePost, type ArchiveCategory } from '../archive/data';
import { imageSource, type SiteSettings } from '../data/site';
import type { LibraryItem } from '../data/library';
import '../styles/archive.css';
interface Props {
  posts: ArchivePost[];
  categories: readonly ArchiveCategory[];
  library?: LibraryItem[];
  site: Pick<SiteSettings, 'name' | 'title' | 'archiveTitle' | 'archiveSubtitle' | 'footerLabel' | 'logo' | 'libraryTypes'>;
}
const { posts, categories, site, library = [] } = Astro.props;
const logo = imageSource(site.logo);
const collection = createArchiveCollection(
  posts.map(({ id, slug, title, summary, category, categoryId, date, tags, readTime }) => ({ id, slug, title, summary, category, categoryId, date, tags, readTime })),
  categories,
  library.map(item => ({ ...item, cover: imageSource(item.cover) })),
  site.libraryTypes,
);
const records = collection.posts;
const first = records[0];
const populatedCategories = collection.categories.filter(category => records.some(record => record.categoryId === category.id));
const serialized = JSON.stringify({ ...collection, branding: { title: site.archiveTitle, subtitle: site.archiveSubtitle } }).replace(/</g, '\\u003c');
---
<section id="archives" class="archive-section" data-mode="archive" data-empty={String(!records.length)} aria-label="Blog and Library archive">
  <div id="archive-canvas" data-archive-title={site.archiveTitle} aria-label="3D archive. Use arrow keys to select."></div>

  <header class="archive-brand" aria-label={site.title}>
    <a href="#welcome" data-logo-slot aria-label={`${site.name} home`}>{logo && <img class="archive-logo" data-fallback-image src={logo} alt="" />}<strong data-logo-fallback hidden={Boolean(logo)}>{site.name}</strong><span>{site.archiveSubtitle}</span><b>{site.archiveTitle} <i>01</i></b></a>
  </header>
  <nav class="archive-system-nav" aria-label="Archive navigation">
    <a href="/blog/" class="archive-index-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 5 5"/></svg><span>Blog</span></a>
    <a href="/library/" class="archive-index-link archive-library-link"><span>Library</span></a>
    <button type="button" class="theme-toggle archive-theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme"><svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.6 13.4A8.5 8.5 0 0 1 10.6 3a8.5 8.5 0 1 0 10 10.4Z"/></svg></button>
  </nav>

  <div id="archive-selection" class="archive-selection">
    <div class="archive-callout">
      <div class="archive-kicker">{site.archiveTitle} <span>/</span> <span id="archive-category">{first?.category}</span></div>
      <button type="button" id="archive-open" class="archive-file-button" aria-label="Preview selected entry">FILE NUMBER: <span id="archive-file-code">{first?.kind === 'library' ? 'L' : 'B'}-001</span><i aria-hidden="true">↗</i></button>
      <div class="archive-callout-rule" aria-hidden="true"><i></i></div>
      <h2 id="archive-title">{first?.title}</h2>
      <div class="archive-callout-meta"><span id="archive-date">{first?.date}</span><span id="archive-kind">BLOG / ARTICLE</span></div>
      <button type="button" id="archive-extract" class="archive-extract">Preview <span aria-hidden="true">→</span></button>
    </div>

    <div class="archive-counter"><span>ARCHIVE / SELECT</span><div><strong id="archive-number">{records.length ? '01' : '00'}</strong><i>/</i><span id="archive-total">{String(records.filter(record => record.categoryId === first?.categoryId).length).padStart(2, '0')}</span></div></div>
    <div class="archive-row-navigation" aria-label="Select entry"><button id="archive-prev" type="button" aria-label="Previous entry">↑</button><div id="archive-ticks" class="archive-ticks" aria-hidden="true"></div><button id="archive-next" type="button" aria-label="Next entry">↓</button><span id="archive-count" class="archive-sr-only"></span></div>
    <div class="archive-column-navigation" aria-label="Category"><button id="category-prev" type="button" aria-label="Previous category">←</button><div><span>COLUMN <span id="archive-category-count">{records.length ? '01' : '00'} / {String(populatedCategories.length).padStart(2, '0')}</span></span><strong id="archive-category-name">{first?.category}</strong></div><button id="category-next" type="button" aria-label="Next category">→</button></div>
    <div id="archive-categories" class="archive-categories" aria-label="Blog categories and Library types"></div>
    <p class="archive-keyboard-hint"><kbd>←</kbd> <kbd>→</kbd> Category <i>/</i> <kbd>↑</kbd> <kbd>↓</kbd> Entry <i>/</i> <kbd>ENTER</kbd> Preview</p>
  </div>

  <div id="archive-preview" class="archive-preview" aria-hidden="true" inert>
    <button id="archive-back" class="archive-back" type="button">← <span>Archive</span><small>ESC</small></button>
    <div class="archive-object-caption" aria-hidden="true"><span id="archive-object-code">NO.001</span><small>{site.archiveTitle}</small></div>
    <article id="archive-preview-content" class="archive-preview-content" aria-labelledby="archive-preview-title" tabindex="-1">
      <div class="archive-preview-kicker"><span id="archive-preview-code">FILE {first?.kind === 'library' ? 'L' : 'B'}-001</span><span id="archive-preview-kind">ARTICLE PREVIEW</span></div>
      <div class="archive-preview-heading">
        <div><h2 id="archive-preview-title">{first?.title}</h2><p id="archive-preview-original" class="archive-preview-original" hidden></p><p class="archive-preview-subtitle"><span id="archive-preview-category">{first?.category}</span><span id="archive-preview-label">{site.archiveTitle}</span></p></div>
        <img id="archive-preview-cover" class="archive-preview-cover" alt="" width="84" height="112" decoding="async" hidden />
      </div>
      <div class="archive-preview-rule"></div>
      <dl class="archive-metadata">
        <div><dt id="archive-preview-category-label">CATEGORY</dt><dd id="archive-preview-category-value">{first?.category}</dd></div>
        <div><dt id="archive-preview-date-label">PUBLISHED</dt><dd id="archive-preview-date">{first?.date}</dd></div>
        <div><dt>TAGS</dt><dd id="archive-preview-tags">{first?.tags.join(' · ')}</dd></div>
        <div><dt id="archive-preview-reading-label">READING</dt><dd id="archive-preview-readtime">{first?.readTime} min</dd></div>
        <div id="archive-preview-rating-row" hidden><dt>RATING</dt><dd id="archive-preview-rating">Unrated</dd></div>
      </dl>
      <div class="archive-abstract"><span id="archive-summary-label">SUMMARY</span><p id="archive-summary">{first?.summary}</p></div>
      <a id="archive-read" class="archive-read-button" href={first?.href ?? '/blog/'}><span id="archive-read-label">READ ARTICLE</span><i aria-hidden="true">↗</i></a>
      <div class="archive-preview-footnote"><span id="archive-preview-count">{records.length ? '001' : '000'} / {String(records.length).padStart(3, '0')}</span></div>
    </article>
  </div>

  <div class="archive-empty"><span>BLOG / LIBRARY</span><h2>Enter blog or library content</h2><a href="/blog/">Blog →</a><a href="/library/">Library →</a></div>
  <div class="archive-footer"><span id="archive-status" role="status" aria-live="polite">{records.length ? 'Loading archive' : 'No entries'}</span><span>{String(posts.length).padStart(2, '0')} BLOG <i>/</i> {String(library.length).padStart(2, '0')} LIBRARY <i>/</i> {String(records.length).padStart(3, '0')} RECORDS</span></div>
  <noscript><div class="archive-noscript"><p>Enable JavaScript for the 3D archive.</p><a href="/blog/">Blog →</a><a href="/library/">Library →</a></div></noscript>
  <script id="archive-data" type="application/json" set:html={serialized}></script>
</section>
<script>import '../scripts/archive';</script>
