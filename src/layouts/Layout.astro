---
import { ClientRouter } from 'astro:transitions';
import { site, siteBaseURL, imageSource } from '../data/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string; }
const { title = site.title, description: pageDescription, active = 'home' } = Astro.props;
const description = pageDescription?.trim() || site.description;
const pageTitle = title === site.title ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, siteBaseURL(Astro.site ?? Astro.url.origin));
const logo = imageSource(site.logo);
---
<!doctype html>
<html lang="en" data-theme={site.defaultTheme === 'dark' ? 'dark' : 'light'} data-default-theme={site.defaultTheme} data-page={active}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eae5e1" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/typography.css" />
    <link rel="license" href="/fonts/MiSans-license.pdf" title="MiSans font license" />
    <link rel="icon" href={imageSource(site.favicon) || '/favicon.svg'} />
    {site.showRSS && <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('field-theme'); } catch {}
        const defaultTheme = document.documentElement.dataset.defaultTheme;
        theme = theme === 'light' || theme === 'dark' ? theme : defaultTheme === 'light' || defaultTheme === 'dark' ? defaultTheme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#11181b' : '#eae5e1');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a href="/" class="site-brand" data-logo-slot aria-label={`${site.name} home`}>
        {logo && <img class="site-logo" data-fallback-image src={logo} alt="" />}
        <span data-logo-fallback hidden={Boolean(logo)}>{site.name}</span>
      </a>
      <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
        {site.navigation.map(item => <a href={item.href} class:list={{ 'nav-active': active === item.id }} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        {site.github && <a class="icon-button social-icon" href={site.github} target="_blank" rel="noopener noreferrer" aria-label={site.demo ? 'GitHub (demo)' : 'GitHub'} title={site.demo ? 'GitHub (demo)' : 'GitHub'}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.9c0-1.1-.4-1.8-.8-2.2 2.8-.3 5.8-1.4 5.8-6.2a4.9 4.9 0 0 0-1.3-3.4 4.6 4.6 0 0 0-.1-3.4S17.5 2.6 15 4a11.7 11.7 0 0 0-6 0C6.5 2.6 5.4 2.9 5.4 2.9a4.6 4.6 0 0 0-.1 3.4A4.9 4.9 0 0 0 4 9.7c0 4.8 3 5.9 5.8 6.2-.4.4-.8 1.2-.8 2.2V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>}
        {site.email && <a class="icon-button social-icon" href={`mailto:${site.email}`} aria-label="Email" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg></a>}
        {site.showRSS && <a class="icon-button social-icon" href="/rss.xml" aria-label="RSS" title="RSS"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="5" cy="19" r="1.7" fill="currentColor"/></svg></a>}
        <span class="header-divider" aria-hidden="true"></span>
        <button class="icon-button theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme"><svg class="sun-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="moon-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 13.1A8.8 8.8 0 0 1 10.9 3.5 8.8 8.8 0 1 0 20.5 13.1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        {site.navigation.length > 0 && <button class="icon-button menu-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Open menu"><span></span><span></span></button>}
      </div>
    </header>
    <main id="main"><slot /></main>
    {active !== 'home' && <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.name}{site.footerLabel && <><i> / </i> {site.footerLabel}</>}</span>
      <span class="footer-note">{site.footerNote}</span>
      <a href="/blog/">{site.pages.blog.title} <span aria-hidden="true">↗</span></a>
    </footer>}
    <script>import '../scripts/global';</script>
  </body>
</html>
